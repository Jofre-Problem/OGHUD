[BG:#35302C]
Window();
[Border:0, FG:#35302C]
Banner("_4plug/thumbnailBanner.png", "auto", "topleft");

[Name:UI Sound Effects, Default:Lower, FG:#7A5EF8, BG:#F4F4F5, Border:0]
GlobalComboBox("UI Sound Effects", "UI Sound Effects")
{
	TF2
	Half-Life
}
[Name:Background, Default:Lower, FG:#7A5EF8, BG:#F4F4F5, Border:0]
GlobalComboBox("Background", "Background")
{
	Background01
	BluOne
}
[Name:UI Style, Default:Lower, FG:#7A5EF8, BG:#F4F4F5, Border:0]
GlobalComboBox("UI Style", "UI Style")
{
	Centered
	OG
}
[Name:TargetID, Default:Lower, FG:#7A5EF8, BG:#F4F4F5, Border:0]
GlobalComboBox("TargetID", "TargetID")
{
	Default
	2007
}
#if TargetID == "Default"
{
Copy("_4plug/files/targetid/targetid_current.res", "resource/ui/targetid.res");
Copy("_4plug/files/targetid/spectatorguihealth_current.res", "resource/ui/spectatorguihealth.res");
Copy("_4plug/files/targetid/layout_c.res", "scripts/hudlayout_4plug_2.res");
}
#if TargetID == "2007"
{
Copy("_4plug/files/targetid/targetid_2007.res", "resource/ui/targetid.res");
Copy("_4plug/files/targetid/spectatorguihealth_2007.res", "resource/ui/spectatorguihealth.res");
Copy("_4plug/files/targetid/layout_2007.res", "scripts/hudlayout_4plug_2.res");
}
#if UI Style == "Centered"
{
Copy("_4plug/files/position/centered/huddemomanpipes_cen.res", "resource/ui/huddemomanpipes.res");
Copy("_4plug/files/position/centered/hudmediccharge_cen.res", "resource/ui/hudmediccharge.res");
Copy("_4plug/files/position/centered/hudlayout_cen.res", "scripts/hudlayout_4plug.res");
}
#if UI Style == "OG"
{
Copy("_4plug/files/position/og/huddemomanpipes_og.res", "resource/ui/huddemomanpipes.res");
Copy("_4plug/files/position/og/hudmediccharge_og.res", "resource/ui/hudmediccharge.res");
Copy("_4plug/files/position/og/hudlayout_og.res", "scripts/hudlayout_4plug.res");
}
#if Background == "Background01"
{
Copy("_4plug/files/bg/default.txt", "scripts/chapterbackgrounds.txt");
}

#if Background == "BluOne"
{
Copy("_4plug/files/bg/upward.txt", "scripts/chapterbackgrounds.txt");
}

#if UI Sound Effects == "TF2"
{
Copy("_4plug/files/tf2ui/buttonclick.wav", "sound/ui/buttonclick.wav");
Copy("_4plug/files/tf2ui/buttonclickrelease.wav", "sound/ui/buttonclickrelease.wav");
Copy("_4plug/files/tf2ui/buttonrollover.wav", "sound/ui/buttonrollover.wav");
}
#if UI Sound Effects == "Half-Life"
{
Copy("_4plug/files/hl2/buttonclick.wav", "sound/ui/buttonclick.wav");
Copy("_4plug/files/hl2/buttonclickrelease.wav", "sound/ui/buttonclickrelease.wav");
Copy("_4plug/files/hl2/buttonrollover.wav", "sound/ui/buttonrollover.wav");
}